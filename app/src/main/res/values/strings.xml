    <string name="debug_switch">Record events and window dumps</string>
    <string name="debug_note">Meet event logs and a screen dump every 5 seconds will appear in the same folder. Turn it off when you\'re done.</string>

    <string name="channel_recording">Caption recording</string>
    <string name="notice_recording">Recording captions</string>

