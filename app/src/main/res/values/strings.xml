<resources>
    <string name="app_name" translatable="false">Meet Captions</string>
    <string name="service_description">Reads Google Meet captions from the screen and saves them to Documents/MeetCaptions. Sends nothing over the network.</string>
    <string name="tagline">Saves Google Meet call captions as text files. No internet.</string>

    <string name="status_on">Recording. Turn on captions in the call and the text saves itself.</string>
    <string name="status_off">Recording is off.</string>
    <string name="enable_service">Turn on the service</string>
    <string name="restricted_title">Service greyed out in settings?</string>
    <string name="restricted_help">Android restricts apps installed outside a store. Open App info, tap ⋮ in the top right corner and allow restricted settings. Then turn the service on again.</string>
    <string name="open_app_info">Open App info</string>

    <string name="section_transcripts">Transcripts</string>
    <string name="transcripts_folder">Folder Documents/MeetCaptions</string>
    <string name="no_transcripts">Your calls will show up here. Turn on captions in Meet, and after the call its transcript will be in this list.</string>
    <string name="quoted">“%1$s”</string>
    <string name="empty_transcript">No lines</string>
    <string name="share">Share</string>
    <string name="no_app">No app to open a text file</string>

    <string name="section_regex">Caption recognition</string>
    <string name="regex_note">Change only if Meet updated and transcripts stopped appearing. The debug dump shows which id to use.</string>
    <string name="label_text_regex">Caption text id regex</string>
    <string name="label_name_regex">Speaker name id regex</string>
    <string name="hint_text_regex" translatable="false">caption</string>
